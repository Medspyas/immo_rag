# Base de données
DATABASE_URL=postgresql://immo:immo@localhost:5433/immo_rag

# Embeddings : modèle local, gratuit, exécuté sur la machine. Pour un autre
# modèle local, ajuster EMBEDDINGS_MODEL (et EMBEDDINGS_DIMENSION si sa taille
# diffère).
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_DIMENSION=768

# Reclassement des résultats de recherche : cross-encoder local, gratuit.
#   local : exécuté sur le processeur (sentence-transformers), fonctionne
#           partout mais lent (~20 s par requête, cf. eval/latence.py) ;
#   onnx  : même modèle via ONNX Runtime, sur la carte graphique si elle est
#           disponible (~0,6 s). Exporter d'abord le modèle une fois :
#           python scripts/exporter_reclasseur_onnx.py
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Dossier du modèle exporté, lu seulement si RERANK_PROVIDER=onnx.
RERANK_ONNX_DIR=.cache/reclasseur_onnx

# Garde-fou étage 2 (generator.py) : vérifie que la réponse générée reste
# fidèle aux articles cités, via un modèle NLI local et gratuit. Multilingue
# ou français : un modèle anglais-only échouerait silencieusement sur des
# affirmations en français.
NLI_PROVIDER=local
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli

# LLM : résumé de document pour le contextual retrieval (contextualizer.py),
# génération de la réponse et juge de repli du garde-fou étage 2
# (generator.py). Offre gratuite de Groq.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Modèles de relais quand LLM_MODEL a épuisé son quota par minute (quota
# Groq compté par modèle). Format JSON ; [] pour n'utiliser que LLM_MODEL.
LLM_MODELES_RELAIS=["openai/gpt-oss-120b"]

GROQ_API_KEY=

# Relais quand les quotas Groq du jour sont consommés : offre gratuite Mistral
# (« Experiment », console.mistral.ai). Vide : Groq seul.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Origines autorisées à appeler l'API depuis un navigateur (front). Format
# JSON ; [] : aucune.
CORS_ORIGINS=[]
